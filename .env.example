# scripts/export.ps1 的本地配置：复制为 .env 后修改（.env 不会提交）。
# 同名的系统环境变量优先于这里的值。

# Prism 里装了 GTNH 的实例文件夹名（instances 目录下的名字，不是显示名）。必填。
PRISM_INSTANCE=GT_New_Horizons_2.9.0_Java_17-26

# 离线账号名，用于 --offline 启动，不需要登录。
PRISM_ACCOUNT=Dumper

# 以下都有默认值，位置不同时才需要填。
# Prism 程序（默认 %LOCALAPPDATA%\Programs\PrismLauncher\prismlauncher.exe）
# PRISM_EXE=
# Prism 数据目录，实例在其下的 instances\<PRISM_INSTANCE>（默认 %APPDATA%\PrismLauncher）
# PRISM_DATA_DIR=
# 直接指定游戏目录（含 mods、config 的那个 .minecraft），覆盖上面两项
# GAME_DIR=
# 要放进实例的 Dumper jar；不填则取 build\libs 里最新的正式 jar
# DUMPER_JAR=
# 单次导出的最长等待分钟数（Dumper 自身的上限是 120）
# EXPORT_TIMEOUT_MIN=120
